<Project>

  <!-- One standard for every project: net10.0, warnings as errors, analyzers at latest-recommended. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>Hubwright contributors</Authors>
    <Product>Hubwright</Product>
    <Copyright>Copyright (c) Hubwright contributors. MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>Hubwright</RootNamespace>
    <NoWarn>$(NoWarn);CA1848;CA1305;CA2007;CA1873;CA1861;CA1716;CA1720;CA1002;CA2227;CA1056;CA1054;CA1055;CA1814;CA1819;CA1859;CA1826</NoWarn>
  </PropertyGroup>

</Project>
